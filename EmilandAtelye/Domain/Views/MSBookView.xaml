<UserControl x:Class="EmilandAtelye.Domain.Views.MSBookView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:ei="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:local="clr-namespace:EmilandAtelye.Domain.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local1="clr-namespace:EmilandAtelye.Converters">
  <Grid Background="White">
    <FrameworkElement.Resources>
      <local1:GroupGen2SampleIdToStringConverter x:Key="SampleIdConverter"/>
      <local1:IngredientsToStringConverter x:Key="IngredientsConverter"/>
    </FrameworkElement.Resources>
    <TabControl>
      <TabItem Header="Malın pasportu">
        <Interaction.Triggers>
          <EventTrigger EventName="PreviewMouseLeftButtonDown">
            <InvokeCommandAction CommandParameter="Malın pasportu" Command="{Binding OpenMalinPasportu}"/>
          </EventTrigger>
        </Interaction.Triggers>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBox Margin="5" Height="20" Width="55" HorizontalAlignment="Left"
                       Text="{Binding CurrentGoods.GoodsId, Mode=TwoWay}">
              </TextBox>
            </StackPanel>
            <StackPanel Margin="10,0,0,0" Width="920" HorizontalAlignment="Left" Orientation="Horizontal">
              <Label Content="*Firmanın adı" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="420" DisplayMemberPath="CompFullname" ItemsSource="{Binding Companies, Mode=TwoWay}"
                        SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"/>
              <Label Margin="75,0,0,0" Content="Axtarış" FontSize="14" FontWeight="Bold"/>
              <Label Margin="80,0,0,0" Content="Ölçü" FontSize="14" FontWeight="Bold"/>
              <Label Margin="70,0,0,0" Content="Rəng" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Alış qiyməti" Width="100" FontWeight="Bold" FontSize="14"/>
              <TextBox Width="120" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.WhPrice, StringFormat=${0:F2}}">
              </TextBox>
              <ComboBox Margin="5,0,0,0" Width="100" DisplayMemberPath="CurType" ItemsSource="{Binding CurrencyTypes}"
                        SelectedItem="{Binding SelectedCurrency}"/>
              <Label Margin="10,0,0,0" Content="Zakroynu" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="12,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.RestManualCount, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="15,0,0,0" Content="KOST" FontSize="14"/>
              <TextBox GotFocus="Kost_OnGotFocus" Margin="14,0,0,0" Width="100"
                       Text="{Binding Kost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
              </TextBox>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="11,10,0,0" Orientation="Horizontal">
              <Label Content="Miqdarı" Width="99" FontWeight="Bold" FontSize="14"/>
              <TextBox Width="120" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.RestManualCount, StringFormat=${0:F2}}">
              </TextBox>
              <ComboBox Margin="6,0,0,0" Width="100" DisplayMemberPath="Measure" ItemsSource="{Binding MeasureUnits}"
                        SelectedItem="{Binding SelectedMeasureUnit}"/>
              <Label Margin="10,0,0,0" Content="T.Əliyev 86" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="2,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store1, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="18,0,0,0" Content="KÖY" FontSize="14"/>
              <TextBox GotFocus="Koy_OnGotFocus" Margin="19,0,0,0" Width="100"
                       Text="{Binding Koy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="*Limit göy" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding CurrentGoods.LimitBlue, Mode=TwoWay}"/>
              <Label Margin="10,0,0,0" Content="Füzuli 63" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="16,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store2, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="19,0,0,0" Content="ZAP" FontSize="14"/>
              <TextBox GotFocus="Zap_OnGotFocus" Margin="19,0,0,0" Width="100"
                       Text="{Binding Zap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="*Limit Qırmızı" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding CurrentGoods.LimitRed, Mode=TwoWay}"/>
              <Label Margin="10,0,0,0" Content="Nizami 77" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="9,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store3, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="19,0,0,0" Content="QALS" FontSize="14"/>
              <TextBox GotFocus="Qals_OnGotFocus" Margin="10,0,0,0" Width="100"
                       Text="{Binding Qals, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="*Daxili kodu" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding CurrentGoods.GoodsCode, Mode=TwoWay}"/>
              <Label Margin="10,0,0,0" Content="H.CAVİD" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="19,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store4, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="19,0,0,0" Content="YAYL" FontSize="14"/>
              <TextBox GotFocus="Yayl_OnGotFocus" Margin="14,0,0,0" Width="100"
                       Text="{Binding Yayl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="*Sıra №" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding CurrentGoods.RowNo, Mode=TwoWay}"/>
              <Label Margin="10,0,0,0" Content="M.İlinka 4" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="10,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store5, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="19,0,0,0" Content="JİLET" FontSize="14"/>
              <TextBox GotFocus="Jilet_OnGotFocus" Margin="13,0,0,0" Width="100"
                       Text="{Binding Jilet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Malın kodu" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding CurrentGoods.IntGoodsCode, Mode=TwoWay}"/>
              <Label Margin="10,0,0,0" Content="M.K" FontSize="14" FontWeight="Bold"/>
              <TextBox Margin="49,0,0,0" Width="100" FontWeight="Bold" FontSize="15" HorizontalContentAlignment="Right"
                       Text="{Binding CurrentGoods.Store6, StringFormat=${0:F2}}">
              </TextBox>
              <Label Margin="17,0,0,0" Content="CORAB" FontSize="14"/>
              <TextBox GotFocus="Corab_OnGotFocus" Margin="0,0,0,0" Width="100"
                       Text="{Binding Corab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Ölçü" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="225" DisplayMemberPath="Size" ItemsSource="{Binding Sizes, Mode=TwoWay}"/>
              <Label Margin="50,0,0,0" Content="Satış qiymətləri Az/Rus"/>
              <Label Margin="44,0,0,0" Content="AYAG" FontSize="14"/>
              <TextBox GotFocus="Ayag_OnGotFocus" Margin="0,0,0,0" Width="100"
                       Text="{Binding Ayag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Margin="10,0,0,0" Width="100" DisplayMemberPath="Size" ItemsSource="{Binding Sizes, Mode=TwoWay}"/>
              <ComboBox Margin="10,0,0,0" Width="100" DisplayMemberPath="ColorName"
                        ItemsSource="{Binding Colors, Mode=TwoWay}"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Rəng" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="225" DisplayMemberPath="ColorName" ItemsSource="{Binding Colors, Mode=TwoWay}"/>
              <StackPanel x:Name="Kost1" Orientation="Horizontal">
                <Label Margin="15,0,0,0" Content="Kostyum"/>
                <TextBox Height="20" Margin="0,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Koy1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Köynək"/>
                <TextBox Height="20" Margin="8,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Zap1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Zap"/>
                <TextBox Height="20" Margin="26,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Qals1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Qals"/>
                <TextBox Height="20" Margin="23,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Yayl1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Yayl"/>
                <TextBox Height="20" Margin="26,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Jilet1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Jilet"/>
                <TextBox Height="20" Margin="26,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Corab1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Corab"/>
                <TextBox Height="20" Margin="15,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Ayaq1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Ayaq"/>
                <TextBox Height="20" Margin="19,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Kemer1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Kəmər"/>
                <TextBox Height="20" Margin="12,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Qurs1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Qurş"/>
                <TextBox Height="20" Margin="21,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Bab1" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Bab"/>
                <TextBox Height="20" Margin="26,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SuiteSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <Label Margin="5,0,0,0" Content="KƏMƏR" FontSize="14"/>
              <TextBox GotFocus="Kemer_OnGotFocus" Margin="0,0,0,0" Width="100"
                       Text="{Binding Kemer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Qeyd" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <TextBox Width="225" Text="{Binding Note1, Mode=TwoWay}"/>
              <StackPanel x:Name="Kost2" Orientation="Horizontal">
                <Label Margin="15,0,0,0" Content="Pencək"/>
                <TextBox Height="20" Margin="9,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.JacketSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <StackPanel x:Name="Koy2" Orientation="Horizontal" Visibility="Collapsed">
                <Label Margin="15,0,0,0" Content="Köy smo"/>
                <TextBox Height="20" Margin="1,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.JacketSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65" Visibility="Hidden"/>
              </StackPanel>
              <Label Margin="5,0,0,0" Content="Qurş" FontSize="14"/>
              <TextBox GotFocus="Qurs_OnGotFocus" Margin="20,0,0,0" Width="100"
                       Text="{Binding Qurs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Tərkib 1 / %" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="120" DisplayMemberPath="CompositionName" ItemsSource="{Binding Compositions, Mode=TwoWay}"/>
              <IntegerUpDown FrameworkElement.Margin="5,0,0,0" FrameworkElement.Width="100"/>
              <StackPanel x:Name="Kost3" Orientation="Horizontal">
                <Label Margin="15,0,0,0" Content="Şalvar"/>
                <TextBox Height="20" Margin="15,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.PantsSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <Label Margin="9,0,0,0" Content="BAB" FontSize="14"/>
              <TextBox GotFocus="Bab_OnGotFocus" Margin="20,0,0,0" Width="100"
                       Text="{Binding Bab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
              <ComboBox Margin="10,0,0,0" Width="100"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Tərkib 2 / %" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="120" DisplayMemberPath="CompositionName" ItemsSource="{Binding Compositions, Mode=TwoWay}"/>
              <IntegerUpDown FrameworkElement.Margin="5,0,0,0" FrameworkElement.Width="100"/>
              <StackPanel x:Name="Kost4" Orientation="Horizontal">
                <Label Margin="15,0,0,0" Content="Palto"/>
                <TextBox Height="20" Margin="20,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SmokingSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <Button Margin="70,0,0,0" Content="Qiymətləri dəyişdir (AZ)" Height="23" Width="310"
                      HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Tərkib 3 / %" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="120" DisplayMemberPath="CompositionName" ItemsSource="{Binding Compositions, Mode=TwoWay}"/>
              <IntegerUpDown FrameworkElement.Margin="5,0,0,0" FrameworkElement.Width="100"/>
              <StackPanel x:Name="Kost5" Orientation="Horizontal">
                <Label Margin="15,0,0,0" Content="Jilet"/>
                <TextBox Height="20" Margin="26,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.WaistcoatSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
              <Button Margin="70,0,0,0" Content="Qiymətləri dəyişdir (RUS)" Height="23" Width="310"
                      HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <Label Content="Yeni Sifariş" Width="100" FontWeight="Bold" HorizontalAlignment="Left" FontSize="14"/>
              <ComboBox Width="225" ItemsSource="{Binding YesNo, Mode=TwoWay}"/>
              <StackPanel x:Name="Kost6" Orientation="Horizontal">
                <Label Margin="13,0,0,0" Content="Kost smo"/>
                <TextBox Height="20" Margin="0,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right"
                         Text="{Binding CurrentGoods.SuiteSmokingSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Width="920" HorizontalAlignment="Left" Margin="10,10,0,0" Orientation="Horizontal">
              <StackPanel x:Name="Kost8" Orientation="Horizontal">
                <Button Height="30" Width="100" Margin="100,0,0,0" Content="Save" FontSize="22" FontWeight="Bold"
                        Command="{Binding SaveCommand}"/>
              </StackPanel>
              <Label Margin="155,0,0,0" Content="Yubka"/>
              <StackPanel x:Name="Kost7" Orientation="Horizontal">
                <TextBox Height="20" Margin="0,0,0,0" Width="65" FontWeight="Bold" FontSize="15"
                         HorizontalContentAlignment="Right" Text="{Binding CurrentGoods.SkirtSp, StringFormat=${0:F0}}">
                </TextBox>
                <TextBox Height="20" Margin="3,0,0,0" Width="65"/>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Name="YeniQiymetler" Header="Yeni qiymətlər">
        <Interaction.Triggers>
          <EventTrigger EventName="PreviewMouseLeftButtonDown">
            <InvokeCommandAction Command="{Binding OpenYeniQiymetler}"/>
          </EventTrigger>
        </Interaction.Triggers>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="107*"/>
            <ColumnDefinition Width="680*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="30"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <StackPanel Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal">
              <Label Content="Tipi" FontSize="16" FontWeight="Bold"/>
              <Label Margin="90,0,0,0" Content="Qiyməti" FontSize="16" FontWeight="Bold"/>
              <Label Margin="50,0,0,0" Content="Yeni qiyməti" FontSize="16" FontWeight="Bold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBox HorizontalAlignment="Left" Height="23" Width="114" Text="{Binding SelectedPrice.GroupGen2Name}"/>
              <TextBox Margin="10,0,0,0" HorizontalAlignment="Left" Height="23" Width="114"
                       Text="{Binding SelectedPrice.SellingPrice}"/>
              <TextBox Margin="10,0,0,0" HorizontalAlignment="Left" Height="23" Width="114"/>
              <Button Margin="20,0,0,0" FontWeight="Bold" Content="Dəyişdir (AZ)" Height="23" Width="120"
                      HorizontalAlignment="Left"/>
              <Button Margin="20,0,0,0" FontWeight="Bold" Content="Dəyişdir (RUS)" Height="23" Width="120"
                      HorizontalAlignment="Left"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Grid.Row="1" Height="30" Grid.ColumnSpan="2">
            <Menu HorizontalAlignment="Left" Width="35" Height="24">
              <MenuItem Header="&gt;" Width="83">
                <MenuItem Header="Görünən sütunlar">
                  <MenuItem Header="Tipi"/>
                  <MenuItem Header="Qiyməti (AZN)"/>
                  <MenuItem Header="Qiyməti (RUS)"/>
                  <MenuItem Header="Miqdarı"/>
                </MenuItem>
                <MenuItem Header="Kəsmək"/>
                <MenuItem Header="Sürətini çəkmək"/>
                <MenuItem Header="Sürətini mənimsətmək"/>
                <MenuItem Header="Silmək"/>
                <MenuItem Header="Hamısını seçmək"/>
              </MenuItem>
            </Menu>
          </StackPanel>
          <DataGrid Margin="5,5,5,5" Grid.Row="2" Grid.ColumnSpan="2" AutoGenerateColumns="False"
                    ItemsSource="{Binding Prices, Mode=TwoWay}"
                    SelectedItem="{Binding SelectedPrice, UpdateSourceTrigger=PropertyChanged}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Tipi" Width="*" Binding="{Binding GroupGen2Name}"/>
              <DataGridTextColumn Header="Qiyməti (AZN)" Width="*" Binding="{Binding SellingPrice}"/>
              <DataGridTextColumn Header="Qiyməti (RUS)" Width="*" Binding="{Binding SellingPrice_Rus}"/>
              <DataGridTextColumn Header="Miqdarı" Width="*" Binding="{Binding Cnt}"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>
      <TabItem Name="Qruplar" Header="Qruplar">
        <Interaction.Triggers>
          <EventTrigger EventName="PreviewMouseLeftButtonDown">
            <InvokeCommandAction Command="{Binding OpenQruplar}"/>
          </EventTrigger>
        </Interaction.Triggers>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="2*"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Vertical" Grid.Column="0">
            <Label HorizontalAlignment="Center" FontSize="11" Content="Qrup 1" FontWeight="Bold"/>
            <Menu HorizontalAlignment="Left" Width="35" Height="24">
