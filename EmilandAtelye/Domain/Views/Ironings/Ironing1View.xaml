<Window x:Class="EmilandAtelye.Domain.Views.Ironings.Ironing1View"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmilandAtelye.Domain.Views.Ironings"
        MouseMove="Window_MouseMove" KeyDown="Window_KeyDown" Title="Ütüləmə" Height="800" Width="1600"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Grid>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="50px"/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <Grid Row="0" Background="White">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock VerticalAlignment="Center" Text="Təhvil tarixi:" Margin="20px 0 0 0"/>
          <DatePicker VerticalAlignment="Center" Margin="3px 0 0 0" SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
          <Button Content="&lt;&lt;" Margin="8px 0" Height="20px" Width="25px" Command="{Binding PreviousDayCommand}"/>
          <Button Content="&gt;&gt;" Height="20px" Width="25px" Command="{Binding NextDayCommand}"/>
          <StackPanel Orientation="Vertical" Margin="30px 0 0 0" Height="47px">
            <TextBlock>Kodu</TextBlock>
            <TextBox Width="70px" Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Vertical" Margin="5px 0 0 0" Height="47px">
            <TextBlock>Adı</TextBlock>
            <TextBox Width="130px" Text="{Binding NameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          </StackPanel>
          <StackPanel Orientation="Vertical" Margin="5px 0" Height="47px">
            <TextBlock>Soyadı</TextBlock>
            <TextBox Width="130px" Text="{Binding SurNameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
          </StackPanel>
          <Button Height="17px" Width="17px" Command="{Binding ResetCommand, Mode=TwoWay}">
            <ContentControl.Content>
              <Image Source="/Domain/Images/reset.png" Stretch="Uniform" RenderTransformOrigin="3.735,1.056"/>
            </ContentControl.Content>
          </Button>
          <StackPanel Orientation="Horizontal">
            <Button Width="80px" FontWeight="Bold" Height="18px" Margin="10px 0 0 0" Padding="0" Content="Planlama"
                    Command="{Binding PlanlamaCommand}"/>
            <Button Width="80px" FontWeight="Bold" Height="18px" Margin="3px 0 0 0" Padding="0" Content="Kəsim"
                    Command="{Binding KesimCommand}"/>
            <Button Width="80px" FontWeight="Bold" Height="18px" Margin="3px 0 0 0" Padding="0" Content="1.Hazırdır"
                    Command="{Binding Hazir1Command}"/>
            <Button Width="80px" FontWeight="Bold" Height="18px" Margin="3px 0 0 0" Padding="0" Content="2.Hazırdır"
                    Command="{Binding Hazir2Command}"/>
            <Button Width="80px" FontWeight="Bold" Height="18px" Margin="3px 0 0 0" Padding="0" Content="Son yoxlama"
                    Command="{Binding SonyoxlamaCommand}"/>
          </StackPanel>
        </StackPanel>
      </Grid>
      <Grid Row="1" Background="White">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition Width="0.5*"/>
          </Grid.ColumnDefinitions>
          <DataGrid SelectionChanged="MyDataGrid_SelectionChanged" Name="MyDataGrid" AutoGenerateColumns="False"
                    SelectionMode="Single" HeadersVisibility="All" RowDetailsVisibilityMode="VisibleWhenSelected"
                    IsReadOnly="True" SelectedItem="{Binding SelectedIroningItem1, Mode=TwoWay}"
                    ItemsSource="{Binding IroningsDateTimeNow}">
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Control.Background" Value="{Binding RowBackgroundColor}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="№" Width="0.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding Number}"
                               Background="{Binding BackgroundColor1}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Kodu" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CustomerId}"
                               Background="{Binding BackgroundColor2}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Adı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding CusName}"
                               Background="{Binding BackgroundColor3}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Soyadı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding CusSurname}"
                               Background="{Binding BackgroundColor4}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Tipi" Width=".9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding GroupGen2ShortName}"
                               Background="{Binding BackgroundColor5}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Y" Width=".5*"/>
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid SelectionChanged="MyDataGrid2_SelectionChanged" Name="MyDataGrid2" Grid.Column="1"
                    AutoGenerateColumns="False" HeadersVisibility="All" RowDetailsVisibilityMode="VisibleWhenSelected"
                    IsReadOnly="True" SelectedItem="{Binding SelectedIroningItem2, Mode=TwoWay}"
                    ItemsSource="{Binding IroningsDateTimeAddDaysOne}">
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Control.Background" Value="{Binding RowBackgroundColor}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="№" Width="0.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding Number}"
                               Background="{Binding BackgroundColor1}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Kodu" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CustomerId}"
                               Background="{Binding BackgroundColor2}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Adı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CusName}"
                               Background="{Binding BackgroundColor3}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Soyadı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CusSurname}"
                               Background="{Binding BackgroundColor4}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Tipi" Width=".9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding GroupGen2ShortName}"
                               Background="{Binding BackgroundColor5}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Y" Width=".5*"/>
            </DataGrid.Columns>
          </DataGrid>
          <DataGrid SelectionChanged="MyDataGrid3_SelectionChanged" Name="MyDataGrid3" Grid.Column="2"
                    AutoGenerateColumns="False" HeadersVisibility="All" RowDetailsVisibilityMode="VisibleWhenSelected"
                    IsReadOnly="True" SelectedItem="{Binding SelectedIroningItem3, Mode=TwoWay}"
                    ItemsSource="{Binding IroningsDateTimeAddDaysTwo}">
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="Control.Background" Value="{Binding RowBackgroundColor}"/>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="№" Width="0.3*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding Number}"
                               Background="{Binding BackgroundColor1}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Kodu" Width="1*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CustomerId}"
                               Background="{Binding BackgroundColor2}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Adı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CusName}"
                               Background="{Binding BackgroundColor3}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Soyadı" Width="1.2*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding CusSurname}"
                               Background="{Binding BackgroundColor4}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Tipi" Width=".9*">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock FontSize="13" FontWeight="SemiBold" TextAlignment="Center" Text="{Binding GroupGen2ShortName}"
                               Background="{Binding BackgroundColor5}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Y" Width=".5*"/>
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel Orientation="Vertical" Grid.Column="3" Margin="10px 0">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Margin="0 5px 0 0">Model</TextBlock>
              <TextBox Grid.Column="1" Margin="0 5px 0 0" Text="{Binding SelectedCustomerIroningDetail.P1, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ölçü</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P12, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boy</TextBlock>
              <TextBox Grid.Column="1"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Düymə</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P14, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Kəsik</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P10, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Uzunluq</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P2, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Left" Grid.Column="0">Qol uz</TextBlock>
              <Grid Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SelectedCustomerIroningDetail.P3, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P4, Mode=TwoWay}"/>
              </Grid>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0">Vatka</TextBlock>
              <StackPanel Grid.Column="1" Orientation="Vertical">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding SelectedCustomerIroningDetail.P28, Mode=TwoWay}"/>
                  <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P29, Mode=TwoWay}"/>
                </Grid>
              </StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Left" Grid.Column="0" Text="&lt;&lt;"/>
              <Grid Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SelectedCustomerIroningDetail.P30, Mode=TwoWay}"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P31, Mode=TwoWay}"/>
              </Grid>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Left" Grid.Column="0">Çiyin</TextBlock>
              <TextBox Grid.Column="1"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Kürək</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P7, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boyun</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P5, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Qa. hissə</TextBlock>
              <TextBox Grid.Column="1"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ar. hissə</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P8, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">En</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P9, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Left" Grid.Column="0">Cib</TextBlock>
              <TextBox Grid.Column="1"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Model</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P16, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ölçü</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P24, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boy</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P25, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Qat</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P26, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Bel</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P17, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Zamok</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P18, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Bud</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P19, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Diz</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P20, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Balaq</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P21, Mode=TwoWay}"/>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock HorizontalAlignment="Left" Grid.Column="0">Uzunluq</TextBlock>
              <Grid Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding SelectedCustomerIroningDetail.P22, Mode=TwoWay}"/>
                <TextBox Grid.Column="1"/>
              </Grid>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Forması</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.P2, Mode=TwoWay}"/>
            </Grid>
            <Grid Margin="0 5px 0 0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50px"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Filial</TextBlock>
              <TextBox Grid.Column="1" Text="{Binding SelectedCustomerIroningDetail.DepartShortName, Mode=TwoWay}"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>