<Window x:Class="EmilandAtelye.Domain.Views.DailyExpenseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EmilandAtelye.Domain.Views"
        MouseMove="Window_MouseMove" KeyDown="Window_KeyDown" Title="DailyExpenseView" Height="220"
        Width="800" WindowStartupLocation="CenterScreen">
  <UIElement.InputBindings>
    <KeyBinding Key="Enter" CommandParameter="{Binding ElementName=TextBox}"
                Command="{Binding SaveButtonCommand, Mode=TwoWay}"/>
  </UIElement.InputBindings>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="170"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid Column="0">
      <Grid Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="30"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
          <TextBlock Width="60" Margin="0,10" Text="Xərc adı" FontWeight="Bold" FontSize="14" Grid.Column="0"
                     HorizontalAlignment="Left"/>
          <TextBox KeyUp="TextBox_KeyUp" Width="110" HorizontalAlignment="Left" TabIndex="6"
                   Text="{Binding ExpenseName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
          <ListBox SelectionChanged="ListBox_SelectionChanged" x:Name="SuggestionListBox"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   Margin="0,5,0,0" Width="110" Height="100" ItemsSource="{Binding SuggestionList}">
            <FrameworkElement.Style>
              <Style TargetType="{x:Type ListBox}">
                <Setter Property="UIElement.Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsSuggestionListVisible}" Value="True">
                    <Setter Property="UIElement.Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </FrameworkElement.Style>
          </ListBox>
        </StackPanel>
        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
          <TextBlock Width="40" Text="Filial" FontWeight="Bold" FontSize="14" Grid.Column="0" HorizontalAlignment="Left"/>
          <ComboBox Grid.Row="1" Width="150" DisplayMemberPath="DepartmentName" ItemsSource="{Binding Departments}"
                    SelectedItem="{Binding SelectedDepartment}"/>
          <TextBlock Width="61" Margin="0,10" Text="Məbləğ" FontWeight="Bold" FontSize="14" Grid.Column="0"
                     HorizontalAlignment="Left"/>
          <TextBox Width="110" HorizontalAlignment="Left" TabIndex="7"
                   Text="{Binding OperSumAzn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Column="8" HorizontalAlignment="Center">
          <Button Content="Save" Grid.Row="4" Width="120" Height="60" FontSize="16" FontWeight="Bold"
                  Foreground="White" Background="#6A9FB5" BorderBrush="Transparent" Margin="0,20,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource RoundedButtonStyle}"
                  Command="{Binding SaveButtonCommand, Mode=TwoWay}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>