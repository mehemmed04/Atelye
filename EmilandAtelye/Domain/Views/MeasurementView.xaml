<UserControl x:Class="EmilandAtelye.Domain.Views.MeasurementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EmilandAtelye.Domain.Views">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="100"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="20"/>
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0 5 0 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition Width="50"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="10 0 0 0">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Kodu" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
        <TextBlock Width="40" Margin="0 10 0 5" Text="Tipi" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <ComboBox Width="110" Height="18" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Adı" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
        <TextBlock Width="50" Margin="0 10 0 5" Text="Barkod" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Soyadı" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
        <TextBlock Width="61" Margin="0 10 0 5" Text="Qiyməti" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Qeyd" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
        <TextBlock Width="89" Margin="0 10 0 5" Text="Son Qiymeti" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="4">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Mobil" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
        <TextBlock Width="89" Margin="0 10 0 5" Text="Ödəniş (Beh)" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="110" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="5">
        <TextBlock Width="40" Margin="0 0 0 5" Text="Tel" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Width="70" HorizontalAlignment="Left"/>
        <CheckBox Margin="0 36 0 0" Width="18" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="6">
        <TextBlock Width="95" Text="Təhvil tarixi" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <DatePicker Margin="0,5"/>
        <TextBlock Width="89" Margin="0 0 0 5" Text="Ölçü götürən" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <ComboBox Width="110" Height="18" HorizontalAlignment="Left"/>
      </StackPanel>
      <StackPanel Grid.Column="7">
        <TextBlock Width="95" Margin="11 0 0 5" Text="Kart axtarışı" FontWeight="Bold" FontSize="14" Grid.Column="0"
                   HorizontalAlignment="Left"/>
        <TextBox Margin="10 0 0 0" Width="110" HorizontalAlignment="Left"/>
      </StackPanel>
    </Grid>
    <Grid Row="1" Margin="0 10 0 0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="1.3*"/>
      </Grid.ColumnDefinitions>
      <Grid Column="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Margin="10px 10px">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0" Margin="0 5px 0 0">Model</TextBlock>
            <TextBox Grid.Column="1" Margin="0 5px 0 0"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ölçü</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boy</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Düymə</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Kəsik</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Uzunluq</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Grid.Column="0">Qol uz</TextBlock>
            <Grid Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"/>
              <TextBox Grid.Column="1"/>
            </Grid>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Top" HorizontalAlignment="Left" Grid.Column="0">Vatka</TextBlock>
            <StackPanel Grid.Column="1" Orientation="Vertical">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"/>
                <TextBox Grid.Column="1"/>
              </Grid>
            </StackPanel>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Grid.Column="0" Text="&lt;&lt;"/>
            <Grid Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"/>
              <TextBox Grid.Column="1"/>
            </Grid>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Grid.Column="0">Çiyin</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Kürək</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boyun</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Qa. hissə</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ar. hissə</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">En</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Grid.Column="0">Cib</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
        </StackPanel>
        <StackPanel Orientation="Vertical" Margin="10px 10px" Grid.Column="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Model</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Ölçü</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Boy</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Qat</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Bel</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Zamok</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Bud</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Diz</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Balaq</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock HorizontalAlignment="Left" Grid.Column="0">Uzunluq</TextBlock>
            <Grid Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBox Grid.Column="0"/>
              <TextBox Grid.Column="1"/>
            </Grid>
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Forması</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
          <Grid Margin="0 5px 0 0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="50px"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="0">Filial</TextBlock>
            <TextBox Grid.Column="1"/>
          </Grid>
        </StackPanel>
      </Grid>
      <Grid Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <ComboBox Margin="0 0 10px 0" Width="59" Height="25"/>
          <Button Margin=" 0 0 10px 0" Width="29" Height="25" FontWeight="Bold" FontSize="16" Content="+"/>
          <Button Margin=" 0 0 10px 0" Width="29" Height="25" FontWeight="Bold" FontSize="16" Content="-"/>
          <Button Margin=" 0 0 10px 0" Width="29" Height="25" FontWeight="Bold" Foreground="White" FontSize="16"
                  Content="✔"/>
          <Button Margin=" 0 0 10px 0" Width="29" Height="25" FontWeight="Bold" FontSize="16" Content="- -"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Şəkili sil"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Foreground="Blue" FontWeight="Bold"
                  Content="Kostyum"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Köynək"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Palto"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Jilet"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Yubka"/>
          <Button Margin=" 0 0 10px 0" Width="60" Height="25" FontSize="12" Content="Kassa"/>
        </StackPanel>
        <Image Grid.Row="1"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>