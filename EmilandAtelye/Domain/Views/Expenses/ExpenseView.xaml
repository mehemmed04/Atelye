<UserControl x:Class="EmilandAtelye.Domain.Views.Expenses.ExpenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EmilandAtelye.Domain.Views.Expenses">
  <Grid Background="White">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="5">
      <TextBlock Text="Filial" Margin="5" VerticalAlignment="Center"/>
      <ComboBox Width="150" Margin="5" DisplayMemberPath="DepartmentName" ItemsSource="{Binding Departments}"
                SelectedItem="{Binding SelectedDepartment}"/>
      <TextBlock Text="Xərcin adı" Margin="5" VerticalAlignment="Center"/>
      <TextBox Width="100" Margin="5"
               Text="{Binding ExpenseName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
      <TextBlock Text="Başlama tarixi" Margin="5" VerticalAlignment="Center"/>
      <DatePicker Width="150" Margin="5" SelectedDate="{Binding StartDate}"/>
      <TextBlock Text="Son tarixi" Margin="5" VerticalAlignment="Center"/>
      <DatePicker Width="150" Margin="5" SelectedDate="{Binding EndDate}"/>
    </StackPanel>
    <Grid Margin="10" Row="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DataGrid x:Name="MainDataGrid" Grid.Row="0" AutoGenerateColumns="False" HeadersVisibility="All"
                RowDetailsVisibilityMode="VisibleWhenSelected" IsReadOnly="True" ItemsSource="{Binding Expenses}">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Filial" FontWeight="SemiBold" FontSize="13" Width="130" Binding="{Binding DepartShortName}"/>
          <DataGridTextColumn Header="Xərcin adı" FontWeight="SemiBold" FontSize="13" Width="180" Binding="{Binding ExpenseName}"/>
          <DataGridTextColumn Header="Tarixi" FontWeight="SemiBold" FontSize="13" Width="130"
                              Binding="{Binding OperDate, StringFormat=d}"/>
          <DataGridTextColumn Header="EM $" FontWeight="SemiBold" FontSize="13" Width="130"
                              Binding="{Binding OperSumDollar, StringFormat='${0:#,0.##}'}"/>
          <DataGridTextColumn Header="EM M" FontWeight="SemiBold" FontSize="13" Width="130"
                              Binding="{Binding OperSumAzn, StringFormat='${0:#,0.##}'}"/>
          <DataGridTextColumn Header="BR $" FontWeight="SemiBold" FontSize="13" Width="130"
                              Binding="{Binding OperSumUsdBref, StringFormat='${0:#,0.##}'}"/>
          <DataGridTextColumn Header="BR M" FontWeight="SemiBold" FontSize="13" Width="130"
                              Binding="{Binding OperSumAznBref, StringFormat='${0:#,0.##}'}"/>
        </DataGrid.Columns>
      </DataGrid>
      <Grid x:Name="FooterGrid" Row="1" Background="White" Margin="20,-1,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="150"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0.5"/>
        <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0.5"/>
        <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0.5"/>
        <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0.5">
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding TotalOperSumDollar, StringFormat='${0:#,0.##}'}"/>
          </Grid>
        </Border>
        <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0.5">
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding TotalOperSumAzn, StringFormat='${0:#,0.##}'}"/>
          </Grid>
        </Border>
        <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0.5">
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding TotalOperSumUsdBref, StringFormat='${0:#,0.##}'}"/>
          </Grid>
        </Border>
        <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0.5">
          <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock FontWeight="SemiBold" Text="{Binding TotalOperSumAznBref, StringFormat='${0:#,0.##}'}"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>