<UserControl x:Class="EmilandAtelye.Domain.Views.StockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EmilandAtelye.Domain.Views">
  <Grid Background="White">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" Margin="7,5,3,5">
        <TextBlock Text="Firma" Margin="5" VerticalAlignment="Center"/>
        <ComboBox Width="150" Margin="5" Height="23" ItemsSource="{Binding Companies}"
                  SelectedItem="{Binding SelectedCompany, Mode=TwoWay}"/>
        <TextBlock Text="Qrup 2" Margin="5" VerticalAlignment="Center"/>
        <ComboBox Width="150" Margin="5" Height="23" ItemsSource="{Binding GroupGen2s}"
                  SelectedItem="{Binding SelectedGroupGen2, Mode=TwoWay}"/>
        <TextBlock Text="Barkod" Margin="5" VerticalAlignment="Center"/>
        <TextBox Width="70" Margin="5" Height="23"
                 Text="{Binding BarCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <Grid Margin="55,0,0,0" Width="434" Height="79">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="böyükdür" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="10,1,1,0"/>
          <TextBlock Text="kiçikdir" Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="11,32,89,0"
                     Grid.ColumnSpan="2"/>
          <TextBlock Text="Miqdar" Grid.Row="0" TextAlignment="Center" FontWeight="Bold" Grid.ColumnSpan="2"
                     Margin="29,0,22,51" Grid.RowSpan="2"/>
          <TextBlock Text="T.Ə." Grid.Row="0" Grid.Column="1" TextAlignment="Center" FontWeight="Bold"
                     Grid.ColumnSpan="2" Margin="19,0,81,51" Grid.RowSpan="2"/>
          <TextBlock Text="Füz." Grid.Row="0" Grid.Column="1" TextAlignment="Center" FontWeight="Bold"
                     Grid.ColumnSpan="2" Margin="67,0,33,51" Grid.RowSpan="2"/>
          <TextBlock Text="Niz." Grid.Row="0" Grid.Column="2" TextAlignment="Center" FontWeight="Bold"
                     Grid.ColumnSpan="2" Margin="12,0,88,51" Grid.RowSpan="2"/>
          <TextBlock Text="H.C." Grid.Row="0" Grid.Column="2" TextAlignment="Center" FontWeight="Bold"
                     Grid.ColumnSpan="2" Margin="61,0,39,51" Grid.RowSpan="2"/>
          <TextBlock Text="M.İ." Grid.Row="0" Grid.Column="3" TextAlignment="Center" FontWeight="Bold"
                     Grid.ColumnSpan="2" Margin="10,1,90,50" Grid.RowSpan="2"/>
          <TextBlock Text="Ümumi" Grid.Row="0" Grid.Column="3" TextAlignment="Center" FontWeight="Bold"
                     Margin="67,-1,33,1" Grid.ColumnSpan="2"/>
          <TextBox PreviewTextInput="TextBox_PreviewTextInput" DataObject.Pasting="TextBox_Pasting" Grid.Row="1"
                   Grid.Column="1" Margin="3,3,56,30"
                   Text="{Binding MiqdarBoyukdur, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="54,3,5,30"
                   Text="{Binding Boyukdur1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="3,32,56,1"
                   Text="{Binding MiqdarKichikdir, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="1" Margin="54,32,5,1"
                   Text="{Binding Kichikdir1, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="3,3,56,30"
                   Text="{Binding Boyukdur2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="3,32,56,1"
                   Text="{Binding Kichikdir2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="51,3,8,30"
                   Text="{Binding Boyukdur3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="51,32,8,1"
                   Text="{Binding Kichikdir3, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="99,3,60,30" Grid.ColumnSpan="2"
                   Text="{Binding Boyukdur4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="2" Margin="99,32,60,1" Grid.ColumnSpan="2"
                   Text="{Binding Kichikdir4, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="48,3,11,30"
                   Text="{Binding Boyukdur5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="48,32,11,1"
                   Text="{Binding Kichikdir5, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=}"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="97,3,62,30" Grid.ColumnSpan="2"/>
          <TextBox Grid.Row="1" Grid.Column="3" Margin="97,32,62,1" Grid.ColumnSpan="2"/>
        </Grid>
        <Grid>
          <Button Width="20" Height="20" Command="{Binding ResetCommand, Mode=TwoWay}">
            <ContentControl.Content>
              <Image Source="../Images/reset.png" Stretch="Uniform" RenderTransformOrigin="3.735,1.056"/>
            </ContentControl.Content>
          </Button>
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
          <Button Width="20" Height="20" Background="Green" BorderBrush="Black" Command="{Binding GreenCommand}"/>
          <Button Width="20" Height="20" Background="Red" BorderBrush="Black" Margin="5,0,0,0"
                  Command="{Binding RedCommand}"/>
          <Button Width="20" Height="20" Background="Blue" BorderBrush="Black" Margin="5,0,0,0"
                  Command="{Binding BlueCommand}"/>
          <Button Width="20" Height="20" Background="Black" BorderBrush="Black" Margin="5,0,0,0"
                  Command="{Binding BlackCommand}"/>
        </StackPanel>
      </StackPanel>
      <Grid Margin="10,0,10,10" Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid Loaded="StockDataGrid_Loaded" LoadingRow="DataGrid_LoadingRow" x:Name="StockDataGrid" Grid.Row="0"
                  Margin="0" AutoGenerateColumns="False" HeadersVisibility="All" IsReadOnly="True"
                  ItemsSource="{Binding Stock}">
          <DataGrid.Columns>
            <DataGridTemplateColumn Header="Firma" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Initial}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Alış qiyməti" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding WHPrice}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Miqdar" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding RestManualCount}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="T.Əliyev 86" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Store1}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Füzuli 63" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Store2}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Nizami 77" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Store3}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="H.Cavid" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Store4}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="M.İlinka" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Store5}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Daxili kodu" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding BarCode}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Malın kodu" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding IntGoodsCode}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Qeyd" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Note1}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Kost" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Kostyum}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ko-S" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Kostyum_Smoking}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Pencək" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Pencek}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Şalvar" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Shalvar}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Palto" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Palto}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Jilet" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Jilet}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Yubka" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Yubka}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Köynək" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Koynek}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Ko-S2" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Koynek_Smoking}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTemplateColumn Header="Sifariş" Width="85">
              <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                  <TextBlock FontWeight="SemiBold" FontSize="13" Text="{Binding Ordered}" Foreground="{Binding Color}"/>
                </DataTemplate>
              </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
          </DataGrid.Columns>
        </DataGrid>
        <Grid x:Name="FooterGrid" Row="1" Background="White" Margin="20,0,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="70"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding GoodsCount, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="1" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="2" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding GoodsQuantity, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="3" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Total1, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="4" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Total2, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="5" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Total3, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="6" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Total4, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="7" BorderBrush="Black" BorderThickness="0.5">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock FontWeight="SemiBold" Text="{Binding Total5, Mode=TwoWay, StringFormat=0.#}"/>
            </Grid>
          </Border>
          <Border Grid.Column="8" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="9" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="10" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="11" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="12" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="13" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="14" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="15" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="16" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="17" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="18" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="19" BorderBrush="Black" BorderThickness="0.5"/>
          <Border Grid.Column="20" BorderBrush="Black" BorderThickness="0.5"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>